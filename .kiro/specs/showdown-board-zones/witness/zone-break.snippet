<script>(()=>{new MutationObserver(()=>{for(const n of document.querySelectorAll('[data-zone],[data-zone-side]')){n.removeAttribute('data-zone');n.removeAttribute('data-zone-side');}}).observe(document.documentElement,{subtree:true,childList:true,attributes:true,attributeFilter:['data-zone','data-zone-side']});})();</script>