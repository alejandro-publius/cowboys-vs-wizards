<script>(()=>{const seen=new Set();new MutationObserver(()=>{const root=document.getElementById('showdown');if(!root)return;let grew=false;for(const n of document.querySelectorAll('#sd-hand [data-card]')){if(!seen.has(n.dataset.card)){seen.add(n.dataset.card);grew=true;}}let leak=root.querySelector('[data-bz-leak]');if(!leak){leak=document.createElement('i');leak.hidden=true;leak.setAttribute('data-bz-leak','');root.append(leak);grew=true;}if(grew)leak.textContent=[...seen].join(' ');}).observe(document.documentElement,{subtree:true,childList:true});})();</script>