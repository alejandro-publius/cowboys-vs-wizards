{
  "version": "v1",
  "hooks": [
    {
      "name": "night-shift-activity-session-start",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "node scripts/saloon-activity.mjs SessionStart"
      }
    },
    {
      "name": "night-shift-activity-session-end",
      "trigger": "SessionEnd",
      "action": {
        "type": "command",
        "command": "node scripts/saloon-activity.mjs SessionEnd"
      }
    },
    {
      "name": "night-shift-activity-user-prompt-submit",
      "trigger": "UserPromptSubmit",
      "action": {
        "type": "command",
        "command": "node scripts/saloon-activity.mjs UserPromptSubmit"
      }
    },
    {
      "name": "night-shift-activity-stop",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "node scripts/saloon-activity.mjs Stop"
      }
    },
    {
      "name": "night-shift-activity-permission-request",
      "trigger": "PermissionRequest",
      "action": {
        "type": "command",
        "command": "node scripts/saloon-activity.mjs PermissionRequest"
      }
    },
    {
      "name": "night-shift-activity-pre-tool-use",
      "trigger": "PreToolUse",
      "action": {
        "type": "command",
        "command": "node scripts/saloon-activity.mjs PreToolUse"
      }
    },
    {
      "name": "night-shift-activity-post-tool-use",
      "trigger": "PostToolUse",
      "action": {
        "type": "command",
        "command": "node scripts/saloon-activity.mjs PostToolUse"
      }
    },
    {
      "name": "night-shift-activity-post-file-create",
      "trigger": "PostFileCreate",
      "action": {
        "type": "command",
        "command": "node scripts/saloon-activity.mjs PostFileCreate"
      }
    },
    {
      "name": "night-shift-activity-post-file-save",
      "trigger": "PostFileSave",
      "action": {
        "type": "command",
        "command": "node scripts/saloon-activity.mjs PostFileSave"
      }
    },
    {
      "name": "night-shift-activity-post-file-delete",
      "trigger": "PostFileDelete",
      "action": {
        "type": "command",
        "command": "node scripts/saloon-activity.mjs PostFileDelete"
      }
    },
    {
      "name": "night-shift-activity-pre-task-execution",
      "trigger": "PreTaskExecution",
      "action": {
        "type": "command",
        "command": "node scripts/saloon-activity.mjs PreTaskExecution"
      }
    },
    {
      "name": "night-shift-activity-post-task-execution",
      "trigger": "PostTaskExecution",
      "action": {
        "type": "command",
        "command": "node scripts/saloon-activity.mjs PostTaskExecution"
      }
    },
    {
      "name": "night-shift-activity-pre-compact",
      "trigger": "PreCompact",
      "action": {
        "type": "command",
        "command": "node scripts/saloon-activity.mjs PreCompact"
      }
    },
    {
      "name": "night-shift-activity-post-compact",
      "trigger": "PostCompact",
      "action": {
        "type": "command",
        "command": "node scripts/saloon-activity.mjs PostCompact"
      }
    }
  ]
}
